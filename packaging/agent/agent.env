# Options of the agent service, see: noryx-agent serve --help
# Apply changes with: systemctl restart noryx-agent
#
#   --listen           where the master connects to; allow this port only from the master's IP
#   --log-format json  for log collectors
#   --log-file /var/log/noryx-agent/agent.log
#   --runtime podman   runs the servers with Podman as root instead of Docker, see the installation
#                      docs; --runtime-socket <path> names another socket of the runtime
#   --prereleases      lets the master update this node to pre-releases too, e.g. a test node
NORYX_AGENT_OPTS="--listen :7443"
