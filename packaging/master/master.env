# Options of the master service, see: noryx-master serve --help
# Apply changes with: systemctl restart noryx-master
#
#   --http-addr           where the panel listens (the panel's settings can replace it); it serves HTTPS if its
#                         settings turn it on, otherwise put a TLS reverse proxy in front of it
#   --enroll-addr         where agents enroll; open this port for the nodes
#   --public-enroll-addr  host:port nodes reach the enrollment endpoint at (the panel's settings can replace it)
#   --trusted-proxy       reverse proxies whose X-Forwarded-For header tells the client's address,
#                         e.g. 127.0.0.1 for a proxy on this machine; otherwise all clients share its address
#   --log-format json     for log collectors
#   --log-file /var/log/noryx-master/master.log
#   --prereleases         offers pre-releases as updates too, e.g. for a test panel; updates from the panel
#                         install them, as their installer reads this file
NORYX_MASTER_OPTS="--http-addr 127.0.0.1:8080 --enroll-addr :9443"
