[Unit]
Description=Noryx master
Documentation=https://github.com/QwikByte/noryx
After=network-online.target
Wants=network-online.target noryx-master-update.path

[Service]
User=noryx
Group=noryx
EnvironmentFile=-/etc/noryx/master.env
ExecStart=/usr/bin/noryx-master --data-dir /var/lib/noryx-master serve --restart-exit-code 75 $NORYX_MASTER_OPTS
# Administrators restart the master from the panel: it stops and exits with 75, then
# systemd starts it again, also reading master.env again.
SuccessExitStatus=75
RestartForceExitStatus=75
StateDirectory=noryx-master
StateDirectoryMode=0700
LogsDirectory=noryx-master
LogsDirectoryMode=0700
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
# Only to listen at ports below 1024, e.g. 443 for HTTPS and 80 for Let's Encrypt.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK reads the addresses of the machine, which the self-signed certificate of the panel includes.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
